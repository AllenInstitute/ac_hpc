profiles {
    standard {
        process {
            executor = 'local'
            container = 'docker://russtorres/axonal_connectomics:zarrpy2'
            containerOptions = '--volume /allen:/allen'
            beforeScript = 'chmod o+rw .'
        }
    }

    nodocker {
        process {
            executor = 'local'
        }
    }
    
    

   hpc {
        apptainer {
            enabled = true
            cacheDir = '/allen/programs/celltypes/workgroups/em-connectomics/laughla/Slurm/Singularity_Images/'
            autoMounts = false
            runOptions = '--bind /allen:/allen  --no-mount bind-paths --tmpdir /allen/programs/celltypes/workgroups/em-connectomics/laughla/Slurm/Contrast/output/temp/'
            apptainer.pullTimeout = '2h'
        }

        process {
            maxForks = 20

            withName: createContainer {
                container = 'docker://russtorres/axonal_connectomics:zarrpy2'
                executor = "slurm"
                cpus = '3'
                time = '70:00:00'
                queue = 'emconnectome'
                memory = '30GB'
                clusterOptions = '--exclusive'
            }
        }
    }
}
