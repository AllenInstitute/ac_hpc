profiles {
    standard {
        process {
            executor = 'local'
            container = 'conochur/segment:latest'
            containerOptions = '--volume /allen:/allen'
            beforeScript = 'chmod o+rw .'
        }
    }

    nodocker {
        process {
            executor = 'local'
        }
    }

   hpc {
        apptainer {
            enabled = true
            cacheDir = '/allen/programs/celltypes/workgroups/em-connectomics/laughla/Slurm/Singularity_Images/'
            autoMounts = false
            runOptions = '--bind /allen:/allen  --no-mount bind-paths'
            apptainer.pullTimeout = '2h'
        }

        process {
            maxForks = 10

            withName: createContainer {
                container = 'docker://conochur/segment:latest'
                executor = "slurm"
                cpus = '40'
                time = '80:00:00'
                queue = 'emconnectome'
                memory = '50GB'
                clusterOptions = '--exclusive'
            }
        }
    }
}
